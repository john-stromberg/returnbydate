// Cloudflare Workers static-assets config. `npx wrangler deploy` serves the built site from ./public.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "returnbydate",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
